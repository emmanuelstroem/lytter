<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app writes its schedule cache into this group's container on tvOS, and the
	     Top Shelf is drawn from it before anything is fetched (P14). Must match the app's
	     lytter.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.eopio.lytter</string>
	</array>
</dict>
</plist>
