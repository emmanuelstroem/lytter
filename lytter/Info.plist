<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "remote-notification" was declared with no push registration anywhere in the
	     app. A background mode the app never exercises is an App Review flag. "fetch" is
	     exercised: the show schedule's daily refresh (F33), a BGAppRefreshTask booked for
	     05:05 Copenhagen time. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.eopio.lytter.show-schedule</string>
	</array>
    <!-- SiriKit's media intent, handled in the app (F15): the name-free "Play P3". -->
    <key>INIntentsSupported</key>
    <array>
        <string>INPlayMediaIntent</string>
    </array>
    <key>INSupportedMediaCategories</key>
    <array>
        <string>INMediaCategoryRadio</string>
    </array>
    <!-- CarPlay (F21). The CarPlay role only: the phone's window is SwiftUI's WindowGroup,
         which configures its own scene. Read on iOS alone; tvOS and macOS never create a
         scene of this role, and the delegate class is compiled only for iOS. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>CPTemplateApplicationSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>CarPlay</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <!-- S8: ATS stated rather than inherited. Every host is HTTPS (api, asset and www.dr.dk,
         streams on live-icy.dr.dk and Akamai), so no exception is needed. Not pinned: DR's certificates
         are short-lived Let's Encrypt leaves under rotating intermediates, and a stale pin
         takes the whole app off the air. ATSPolicyTests holds this to exactly one key. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>lytter</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>lytter</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
